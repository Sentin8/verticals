# Sentin8 operator environment — grouped-repo layout (RS §4.4)
#
# Copy to `.env` at the TREE ROOT and adjust. Services load it via the
# shell boot (dotenvy step 3 walks up to the root). This file mirrors the
# monorepo-era contract; the split-specific values are prewired below.
#
# SPDX-FileCopyrightText: Copyright Logically Magic Inc. <hello@logicallymagic.com>
# SPDX-FileCopyrightText: Copyright Hamid Jahanzad <Hamid@Jahanzad.com>
# SPDX-FileCopyrightText: Copyright Contributors to the Sentin8
# SPDX-License-Identifier: Apache-2.0

# ── Identity / domains ──
# Dev default: a public wildcard zone that maps *.local.sentin8.dev to
# 127.0.0.1 (the sentin8.dev zone). Every platform hostname under it
# (e.g. bus.ops.sys.local.sentin8.dev) resolves to the dev box, and acme
# signs those names with the platform CA because the suffix is declared
# in SENTIN8_ACME_LOCAL_DOMAINS below.
SENTIN8_DOMAIN=local.sentin8.dev

# ── Acme (certificate authority) ──
# Suffixes acme classifies LOCAL (signed by the platform CA, HTTP-01
# short-circuited). Comma-separated. Anything NOT matching these or the
# builtin local forms (localhost, .local, private IPs) is EXTERNAL:
# relayed to the upstream public CA when SENTIN8_ACME_UPSTREAM_DIRECTORY_URL
# is set, rejected otherwise.
SENTIN8_ACME_LOCAL_DOMAINS=local.sentin8.dev,local.ibank.dev
# Upstream public ACME directory (external domains). Empty = local-only.
# Use the STAGING endpoint for development (no quota burns):
#   https://acme-staging-v02.api.letsencrypt.org/directory
SENTIN8_ACME_UPSTREAM_DIRECTORY_URL=
# Contact for the upstream ACME account.
SENTIN8_ACME_UPSTREAM_CONTACT=a@m.n
# The proxy's plain-HTTP listener for upstream HTTP-01 challenge
# validation (acme DESIGN §4.3). Only .well-known/acme-challenge/* is
# served; unset = listener not bound. Requires port 80 reachable from
# the internet for external issuance.
SENTIN8_PROXY_HTTP_PORT=80

# ── Infrastructure (the sentin8/ group owns compose; §2.2.1) ──
# The CLI operator runs as the DDL superuser (bootstrap/enroll need DDL +
# the policy seed). SERVICE dev runs fall back to the sentin8_app role
# (sentin8-config default_database_url) — RLS-bounded, NOBYPASSRLS.
DATABASE_URL=postgres://sentin8@localhost:5432/sentin8
# ── Valkey (VALKEYDERIVE-1, group DESIGN.md §3.1) ──
# URLs derive from SENTIN8_VALKEY_HOST/PORT (defaults localhost:6379);
# the /N suffix is inert (GLIDE connects at DB 0 — ACLs isolate). Set
# VALKEY_URL only to override for custom topologies.
# VALKEY_URL=valkeys://localhost:6379/0

# ── Fleet operation (captain) ──
# Binary prefix: colon-separated per-repo target dirs (release mode).
# The root Makefile composes this automatically for `make start`.
# SENTIN8_CAPTAIN_BINARY_PREFIX is a LONG colon chain in this layout —
# prefer the Makefile wrappers.
# SENTIN8_CAPTAIN_LOCAL_IP=           # auto-detected when unset
# SENTIN8_CAPTAIN_TIER_GATE_TIMEOUT=60

# ── Multi-host fleet plane (captain DESIGN §11) ──
# Machine auto-provisioning: the autoscaler leader provisions machines
# through OpenTofu when saturation is sustained + in-machine scaling is
# exhausted. Default profile `auto` with the `docker` backend (dev/test
# fleets); scale-in retires idle machines LIFO, never the base.
SENTIN8_CAPTAIN_PROVISION_PROFILE=auto
SENTIN8_CAPTAIN_PROVISION_BACKEND=docker
SENTIN8_CAPTAIN_MAX_MACHINES=3
SENTIN8_CAPTAIN_MIN_MACHINES=1
# SENTIN8_CAPTAIN_PROVISION_WINDOW_S=60      # sustained-saturation window
# SENTIN8_CAPTAIN_PROVISION_COOLDOWN_S=300   # one machine per window
# SENTIN8_CAPTAIN_PROVISION_IDLE_WINDOW_S=600
# The tofu module dir (ship kit: sentin8-captain/tofu/<backend>/).
# SENTIN8_CAPTAIN_TOFU_DIR=/home/hamid/dev/sentin8.new/sentin8/sentin8-captain/tofu/docker
# SENTIN8_CAPTAIN_TOFU_BIN=tofu
# The operator env file a provisioned machine receives (content becomes
# /etc/sentin8/sentin8.env on the machine; see the tofu module contract).
# SENTIN8_CAPTAIN_MACHINE_ENV_FILE=.run/machine.env
# The edge machine IP — set ONLY on the host serving the :443 ingress
# (the proxy's `pin:edge` placement resolves against this).
# SENTIN8_CAPTAIN_EDGE_IP=
# Host telemetry: procfs (bare-metal/cloud) or cgroup (docker-backend
# containers — /proc/stat is not namespaced, the cgroup read is truth).
# SENTIN8_CAPTAIN_TELEMETRY=procfs

# ── Vertical catalogs (comma-separated catalog.json paths). ABSOLUTE —
#    captain read_to_string()s each path from ITS OWN cwd (a relative
#    entry resolves from the spawn cwd and silently skips: the WARN-19
#    cwd-relative path class). ──
# SENTIN8_CAPTAIN_CATALOG_PATHS=/abs/tree/bank8/catalog.json,/abs/tree/hotel8/catalog.json

# ── Secrets / TLS (captain propagates these to children) ──
SENTIN8_LOG_DIR=.run/logs
SENTIN8_SECRETS_DIR=.run/secrets

# ── Per-service databases (DSNDERIVE-1, group DESIGN.md §3.2): DSNs
#    DERIVE from each service's identity — role = {vertical}_{leaf}_service,
#    database = the vertical, host/port = SENTIN8_PG_HOST/SENTIN8_PG_PORT
#    (defaults localhost/5432). NO per-vertical DSN lines are needed; set
#    {SERVICE}_DATABASE_URL only to OVERRIDE (custom topologies) — captain
#    propagates catalog-declared database_env_vars to the service. ──
# BANK8_LEDGER_DATABASE_URL=postgres://bank8_ledger_service@localhost:5432/bank8

# The full variable reference (393 lines) lives in the original monorepo
# .env.example: /home/hamid/dev/sentin8/sentin8/.env.example